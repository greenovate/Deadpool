<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <Button name="DeadpoolNearbyRowTemplate" hidden="true" virtual="true"
            enableMouse="true" inherits="SecureActionButtonTemplate">
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("AnyDown", "AnyUp");
                self:SetAttribute("type1", "macro");
                self:SetAttribute("macrotext", "/targetexact nil");
            </OnLoad>
            <PreClick>
                Deadpool.modules.Nearby:RowPreClick(self, button);
            </PreClick>
        </Scripts>
    </Button>

</Ui>
